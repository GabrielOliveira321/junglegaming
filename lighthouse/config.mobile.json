{
  "extends": "lighthouse:default",
  "settings": {
    "onlyCategories": [
      "performance",
      "accessibility",
      "best-practices",
      "seo"
    ],
    "formFactor": "mobile",
    "throttlingMethod": "simulate",
    "screenEmulation": {
      "mobile": true,
      "width": 390,
      "height": 844,
      "deviceScaleFactor": 2,
      "disabled": false
    },
    "emulatedUserAgent": "Mozilla/5.0 (Linux; Android 10; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Mobile Safari/537.36"
  }
}
